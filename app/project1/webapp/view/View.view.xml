<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:form="sap.ui.layout.form" xmlns:Icon="sap.ui.core.Icon" controllerName="project1.controller.View"><Page id="bookStorePage" title="BookStore" backgroundDesign="Solid">
        <headerContent>
        <Image src="data:image/png;base64," width="40px" height="40px" id="image1" busyIndicatorSize="Small"/>
        </headerContent>

        <content><OverflowToolbar width="100%" id="toolbar1">
               <content>

                   <ToolbarSpacer id="spacer0"/>
                   <Button id="deleteButton" icon="sap-icon://delete" tooltip="Delete" visible="true" press="onDelete"/>
                   <Button id="editModeButton" tooltip="Edit" press="onEditMode" text="Edit"/>
                   <Button id="btnCreateBook" text="Create" press="onCreate"/>
                   <Button id="btnmigrate" text="migrate" press="onMigrate"/>

               </content>
           </OverflowToolbar>
           <Table id="bookTable" mode="MultiSelect" items="{/Books}" selectionChange="onRowSelectionChange">

                <columns>
                    <Column id="colID">
                        <Text id="txtColID" text="ID"/>
                    </Column>
                    <Column id="colTitle">
                        <Text id="txtColTitle" text="Title"/>
                    </Column>
                    <Column id="colAuthor">
                        <Text id="txtColAuthor" text="Author"/>
                    </Column>
                    <Column id="colPrice">
                        <Text id="txtColPrice" text="Price"/>
                    </Column>
                </columns>
                <items>
                    <ColumnListItem id="bookRow">
                        <cells>
                            <Text id="txtID" text="{ID}"/>
                            <Text id="txtTitle" text="{title}"/>
                            <Text id="txtAuthor" text="{author}"/>
                            <Text id="txtPrice" text="{price}"/>
                        </cells>
                    </ColumnListItem> 
                </items>
            </Table>
        </content>

        <dependents>
            <Dialog id="OpenDialog" title="Add New Book">
                <buttons>
                    <Button id="confirmCreate" text="Save" press="onSave" type="Emphasized"/>
                    <Button id="cancelCreate" text="Cancel" press="onClose" type="Transparent"/>
                </buttons>
                <form:SimpleForm id="bookForm" editable="true" layout="ResponsiveGridLayout">
                    <form:content>
                        <Label id="lblID" text="ID" required="true"/>
                        <Input id="inpID"/>

                        <Label id="lblTitle" text="Title" required="true"/>
                        <Input id="inpTitle"/>
                        
                        <Label id="lblAuthor" text="Author" required="true"/>
                        <Input id="inpAuthor"/>
                        
                        <Label id="lblPrice" text="Price" required="true"/>
                        <Input id="inpPrice"/>
                    </form:content>
                </form:SimpleForm>
            </Dialog>
        </dependents>
    <customHeader>
    </customHeader>
    </Page>
</mvc:View>